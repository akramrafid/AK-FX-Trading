# =============================================================================
# AK Forex Trading System — Environment Configuration Template
# Copy this file to .env and customize for your broker/account environment.
# =============================================================================

# --- MetaTrader 4 DWX Bridge Path ---
# Path to your MT4 terminal's MQL4/Files folder
# Windows Example: C:/Users/<User>/AppData/Roaming/MetaQuotes/Terminal/<ID>/MQL4/Files
MT4_FILES_DIR=./mt4_files

# --- Market & Instrument ---
TRADING_SYMBOL=EURUSD
TRADING_TIMEFRAME=M5
ACCOUNT_INITIAL_BALANCE=10000.00
RISK_PER_TRADE_PCT=0.015

# --- Risk Guardrails & Circuit Breakers ---
MAX_DAILY_LOSS_PCT=0.03
MAX_OPEN_TRADES=1
MAX_DAILY_TRADES=0 # 0 or empty = unlimited daily trades
MAX_SPREAD_PIPS=2.5

# --- Session Hours (UTC: London + NY + Overlap: 07:00 - 21:00 UTC) ---
SESSION_FILTER_ENABLED=true
SESSION_START_HOUR=7
SESSION_END_HOUR=21

# --- Global Emergency Kill Switch ---
EMERGENCY_HALT=false

# --- Execution & Heartbeat Tuning ---
CONFIRMATION_TIMEOUT_SEC=10.0
MAX_HEARTBEAT_AGE_SEC=600.0

# --- Notifications & Alert Integrations ---
# Telegram Bot Token & Target Chat ID for instant mobile alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Generic HTTP Webhook (Discord, Slack, PagerDuty)
ALERT_WEBHOOK_URL=
