//@version=5
// AK Sell Scenarios 1-4: the 1-minute sell strategy of SELL_STRATEGY_PROMPT.md, for checking trades on
// TradingView (FXCM USDCAD, 1m chart). engine/sell_scenarios.py is the source of truth for the backtest
// and the MT4 bridge; this script applies the same rules to the chart's own data.
// - HTF (5m or 15m, closed candles only): bullish X, then bearish Y forming an EQUAL_TOP (S1/S3) or a
//   WICK_SWEEP (S2/S4). The setup is armed from Y's close for "Setup expiry" HTF candles.
// - 1m: bullish A; B1 makes an equal top with A or sweeps A's high; no bullish candle among B1-B3; at most
//   one doji (a doji makes it S3/S4); B1 keeps the highest high. A opens at or after Y's close.
// - SELL at B3's close (process_orders_on_close, the spec's ENTRY_FILL = b3_close). SL = B1 high + 1 point,
//   TP = entry - 10 x risk, SL/TP only. TradingView fills on chart prices: no spread is modelled here.
// - Margin 0.05% (1:2000, the Exness account's leverage) so the tester never blocks 1%-risk position sizes.
strategy("AK Sell Scenarios 1-4", overlay=true, initial_capital=5000, process_orders_on_close=true, pyramiding=100, close_entries_rule="ANY", margin_long=0.05, margin_short=0.05, max_boxes_count=500, max_labels_count=500)

//=============================================================================
// 1. INPUTS (SELL_STRATEGY_PROMPT.md §7; trader decisions 2026-10-25)
//=============================================================================
grp_risk = "1. Risk & Reward"
rr_ratio = input.float(10.0, "Reward-to-Risk (1:X)", minval=0.5, step=0.5, group=grp_risk)
risk_pct = input.float(1.0, "Risk % of balance per trade", minval=0.1, maxval=10.0, step=0.1, group=grp_risk)
max_open = input.int(0, "Max open positions (0 = no limit)", minval=0, group=grp_risk)

grp_scen = "2. Scenarios"
use_s1 = input.bool(true, "S1: HTF equal top", group=grp_scen)
use_s2 = input.bool(true, "S2: HTF wick sweep", group=grp_scen)
use_s3 = input.bool(true, "S3: HTF equal top + doji", group=grp_scen)
use_s4 = input.bool(true, "S4: HTF wick sweep + doji", group=grp_scen)

grp_htf = "3. Higher timeframe"
use_m5           = input.bool(true, "Check 5m", group=grp_htf)
use_m15          = input.bool(true, "Check 15m", group=grp_htf)
htf_eq_tol_pips  = input.float(0.0, "HTF equal-top tolerance (pips)", minval=0.0, step=0.1, group=grp_htf)
expiry_bars      = input.int(3, "Setup expiry (HTF candles after Y closes)", minval=1, group=grp_htf)
invalidate_above = input.bool(false, "Cancel a setup when a 1m candle closes above the HTF high", group=grp_htf)

grp_ltf = "4. 1-minute entry"
ltf_eq_tol_pips = input.float(0.0, "1m equal-top tolerance (pips)", minval=0.0, step=0.1, group=grp_ltf)
doji_tol_pips   = input.float(0.0, "Doji body tolerance (pips)", minval=0.0, step=0.1, group=grp_ltf)
max_doji        = input.int(1, "Max dojis among B1-B3", minval=0, maxval=3, group=grp_ltf)
b1_highest      = input.bool(true, "B1 keeps the highest high", group=grp_ltf)
sl_buffer_pts   = input.int(1, "SL buffer above B1's high (points)", minval=0, group=grp_ltf)
near_htf_pips   = input.float(0.0, "B1 within X pips of the HTF high (0 = off)", minval=0.0, step=0.1, group=grp_ltf)
max_gap_min     = input.int(5, "Max gap between 1m candles (minutes)", minval=1, group=grp_ltf)

grp_session = "5. Session"
use_session   = input.bool(true, "Session filter", group=grp_session)
session_hours = input.session("0700-2100:23456", "Session (UTC): London, London-NY, NY", group=grp_session)

grp_display = "6. Display"
show_boxes  = input.bool(true, "Risk / reward boxes", group=grp_display)
show_labels = input.bool(true, "Scenario, A/B1/B2/B3 and HTF labels", group=grp_display)
box_bars    = input.int(60, "Box width (bars)", minval=5, maxval=400, group=grp_display)

if not (timeframe.isminutes and timeframe.multiplier == 1) and barstate.islast
    runtime.error("AK Sell Scenarios run on the 1-minute chart. Switch the chart to 1m.")

//=============================================================================
// 2. PRICES AS INTEGER POINTS
//=============================================================================
PIP_PTS = 10  // 5-digit (and 3-digit JPY) quotes: 1 pip = 10 points
pts(p) => math.round(p / syminfo.mintick)
htf_tol  = math.round(htf_eq_tol_pips * PIP_PTS)
ltf_tol  = math.round(ltf_eq_tol_pips * PIP_PTS)
doji_tol = math.round(doji_tol_pips * PIP_PTS)
near_tol = math.round(near_htf_pips * PIP_PTS)

// 1 = bullish, -1 = bearish, 0 = doji. The doji test comes first: a doji is never bullish or bearish.
kind(o, c) =>
    body = pts(c) - pts(o)
    math.abs(body) <= doji_tol ? 0 : body > 0 ? 1 : -1

// 0 = none, 1 = EQUAL_TOP, 2 = WICK_SWEEP. X must be bullish; only Y's upper wick may pass X's high.
topPattern(xo, xh, xc, yo, yh, yc, tol) =>
    int res = 0
    if kind(xo, xc) == 1
        xhp = pts(xh)
        yhp = pts(yh)
        if math.abs(yhp - xhp) <= tol
            res := 1
        else if yhp > xhp + tol and pts(yo) <= xhp and pts(yc) < xhp
            res := 2
    res

//=============================================================================
// 3. HTF SETUPS FROM CLOSED 5m / 15m CANDLES (no repainting: [1] = Y, [2] = X)
//=============================================================================
type Setup
    string tf
    int    ptype
    int    yTime
    float  setupHigh
    int    tConf
    int    tExp

var array<Setup> setups = array.new<Setup>()

[m15_yo, m15_yh, m15_yc, m15_yt, m15_xo, m15_xh, m15_xc, m15_xt] = request.security(syminfo.tickerid, "15", [open[1], high[1], close[1], time[1], open[2], high[2], close[2], time[2]], lookahead = barmerge.lookahead_on)
[m5_yo, m5_yh, m5_yc, m5_yt, m5_xo, m5_xh, m5_xc, m5_xt] = request.security(syminfo.tickerid, "5", [open[1], high[1], close[1], time[1], open[2], high[2], close[2], time[2]], lookahead = barmerge.lookahead_on)

armSetup(string tf, int tfMs, yo, yh, yc, yt, xo, xh, xc, xt) =>
    if not na(yt) and not na(xt) and yt - xt == tfMs and kind(yo, yc) == -1
        p = topPattern(xo, xh, xc, yo, yh, yc, htf_tol)
        if p != 0
            tConf = yt + tfMs
            setupHigh = math.max(xh, yh)
            array.push(setups, Setup.new(tf, p, yt, setupHigh, tConf, tConf + expiry_bars * tfMs))
            if show_labels
                label.new(tConf, setupHigh, (p == 1 ? "EQ TOP " : "SWEEP ") + tf, xloc=xloc.bar_time, style=label.style_label_down, color=color.new(color.gray, 25), textcolor=color.white, size=size.small)

new15 = ta.change(time("15")) != 0
new5  = ta.change(time("5")) != 0
if use_m15 and new15
    armSetup("15m", 15 * 60000, m15_yo, m15_yh, m15_yc, m15_yt, m15_xo, m15_xh, m15_xc, m15_xt)
if use_m5 and new5
    armSetup("5m", 5 * 60000, m5_yo, m5_yh, m5_yc, m5_yt, m5_xo, m5_xh, m5_xc, m5_xt)

//=============================================================================
// 4. 1-MINUTE ENTRY: A = [3], B1 = [2], B2 = [1], B3 = the candle that just closed
//=============================================================================
nowMs = time_close
if array.size(setups) > 0
    for i = array.size(setups) - 1 to 0
        s = array.get(setups, i)
        if s.tExp < nowMs or (invalidate_above and pts(close) > pts(s.setupHigh))
            array.remove(setups, i)

gapMs    = max_gap_min * 60000
adjacent = time - time[1] <= gapMs and time[1] - time[2] <= gapMs and time[2] - time[3] <= gapMs
kA  = kind(open[3], close[3])
kB1 = kind(open[2], close[2])
kB2 = kind(open[1], close[1])
kB3 = kind(open, close)
dojiCount  = (kB1 == 0 ? 1 : 0) + (kB2 == 0 ? 1 : 0) + (kB3 == 0 ? 1 : 0)
ltfPattern = topPattern(open[3], high[3], close[3], open[2], high[2], close[2], ltf_tol)
b1High     = pts(high[2])
b1Highest  = not b1_highest or (pts(high[1]) <= b1High and pts(high) <= b1High)
sequenceOk = barstate.isconfirmed and adjacent and kA == 1 and kB1 != 1 and kB2 != 1 and kB3 != 1 and dojiCount <= max_doji and ltfPattern != 0 and b1Highest

// Several setups may match: the 15m one labels the trade before the 5m one, then the latest confirmation.
int best = -1
string matchIds = ""
if sequenceOk and array.size(setups) > 0
    for i = 0 to array.size(setups) - 1
        s = array.get(setups, i)
        nearOk = near_tol == 0 or math.abs(b1High - pts(s.setupHigh)) <= near_tol
        if time[3] >= s.tConf and nowMs <= s.tExp and nearOk
            matchIds := matchIds + (matchIds == "" ? "" : " | ") + s.tf + " Y " + str.format_time(s.yTime, "MM-dd HH:mm", "UTC") + " UTC"
            if best == -1
                best := i
            else
                b = array.get(setups, best)
                if (s.tf == "15m" and b.tf == "5m") or (s.tf == b.tf and s.tConf > b.tConf)
                    best := i

inSession = not use_session or not na(time(timeframe.period, session_hours, "UTC"))
if best != -1
    s = array.get(setups, best)
    scenario = (s.ptype == 1 ? 1 : 2) + (dojiCount > 0 ? 2 : 0)
    enabled  = scenario == 1 ? use_s1 : scenario == 2 ? use_s2 : scenario == 3 ? use_s3 : use_s4
    roomOk   = max_open == 0 or strategy.opentrades < max_open
    sl       = (b1High + sl_buffer_pts) * syminfo.mintick
    entry    = close
    risk     = sl - entry
    if not enabled
        log.info("S{0} skipped: scenario disabled ({1})", scenario, matchIds)
    else if not inSession
        log.info("S{0} skipped: outside session ({1})", scenario, matchIds)
    else if not roomOk
        log.info("S{0} skipped: position limit ({1})", scenario, matchIds)
    else if risk > 0
        tp      = entry - rr_ratio * risk
        balance = strategy.initial_capital + strategy.netprofit
        pv      = (not na(syminfo.pointvalue) and syminfo.pointvalue > 0) ? syminfo.pointvalue : 1.0
        qty     = balance * risk_pct / 100.0 / (risk * pv)
        id      = "S" + str.tostring(scenario) + "-" + str.tostring(bar_index)
        strategy.entry(id, strategy.short, qty=qty)
        strategy.exit("x" + id, from_entry=id, stop=sl, limit=tp)
        array.remove(setups, best)  // one trade per setup
        if show_boxes
            box.new(bar_index, sl, bar_index + box_bars, entry, border_color=color.new(color.gray, 60), bgcolor=color.new(color.gray, 70))
            box.new(bar_index, entry, bar_index + box_bars, tp, border_color=color.new(color.blue, 70), bgcolor=color.new(color.aqua, 85), text="S" + str.tostring(scenario), text_color=color.blue, text_halign=text.align_left, text_valign=text.align_top)
        if show_labels
            label.new(bar_index, sl, "S" + str.tostring(scenario) + " SELL " + str.tostring(entry, format.mintick), style=label.style_label_down, color=color.red, textcolor=color.white, size=size.small, tooltip=matchIds)
            label.new(bar_index - 3, high[3], "A", yloc=yloc.abovebar, style=label.style_none, textcolor=color.blue, size=size.small)
            label.new(bar_index - 2, high[2], "B1", yloc=yloc.abovebar, style=label.style_none, textcolor=color.black, size=size.small)
            label.new(bar_index - 1, high[1], "B2", yloc=yloc.abovebar, style=label.style_none, textcolor=color.black, size=size.small)
            label.new(bar_index, high, "B3", yloc=yloc.abovebar, style=label.style_none, textcolor=color.black, size=size.small)
    else
        log.info("S{0} skipped: close at or above the SL ({1})", scenario, matchIds)

bgcolor(use_session and inSession ? color.new(color.blue, 97) : na, title="Trading session")
